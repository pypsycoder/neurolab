# Copy to .env on the Pi and replace all values before starting containers.
POSTGRES_DB=neuro_lab
POSTGRES_USER=neuro_lab
POSTGRES_PASSWORD=replace-with-a-long-unique-secret
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://neuro_lab:replace-with-a-long-unique-secret@postgres:5432/neuro_lab
ORCHESTRATOR_POLL_SECONDS=3
LOG_LEVEL=INFO

# GigaChat: both lanes use personal API scope. Values of credential variables
# belong only in .env on the Pi, never in this example or Git.
GIGACHAT_BASE_URL=https://api.giga.chat
# OAuth currently uses the dedicated endpoint; model calls use GIGACHAT_BASE_URL.
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_EMBEDDING_MODEL=GigaEmbeddings-3B-2025-09
GIGACHAT_RETRY_ATTEMPTS=5
GIGACHAT_PRIMARY_KEY_ENV=GIGACHAT_KEY_A1
GIGACHAT_FREEMIUM_KEY_ENV=GIGACHAT_KEY_L1
GIGACHAT_ALLOW_FREEMIUM_FALLBACK=false

# OpenRouter is intentionally disabled. There is no OpenRouter adapter in this scaffold.
OPENROUTER_ENABLED=false
