# Never put a real value in this file. Create a local .env or set variables in
# the process environment. Do not commit local environment files.

# GigaChat authorization key, created in the GigaChat API cabinet.
GIGACHAT_CREDENTIALS=

# Select the scope that corresponds to the authorization key.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Current primary API endpoint; do not downgrade TLS verification.
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_TIMEOUT=60
GIGACHAT_VERIFY_SSL_CERTS=true

# Set to 1 only for a deliberately initiated live integration test.
RUN_GIGACHAT_LIVE=0
